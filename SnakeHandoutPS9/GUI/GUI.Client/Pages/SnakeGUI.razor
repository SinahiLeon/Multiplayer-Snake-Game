@page "/snake"
@rendermode InteractiveServer
@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D
@using System.Numerics
@using System.Diagnostics
@using System.Text.Json
@using GUI.Client.Controllers
@using GUI.Client.Models
@inject IJSRuntime JsRuntime;

<PageTitle> Snake </PageTitle>

<div class="input-row">
    <label for="url"> Your Name: </label>
    <input id="url" disabled="@controller.IsConnected" type="text" @bind="PlayerName" />
    <label for="url"> Server Address: </label>
    <input id="url" disabled="@controller.IsConnected" type="text" @bind="ServerDomainName" />
    <label for="url"> Port: </label>
    <input id="port" disabled="@controller.IsConnected" type="number" @bind="ServerPort" class="port" />
    @if (controller.IsConnected)
    {
        <button class="btn btn-primary" @onclick="() => controller.Disconnect()">Disconnect</button>
    }
    else
    {
        <button class="btn btn-primary" @onclick="() => new Thread(() => controller.Connect(ServerDomainName, ServerPort, PlayerName)).Start()">Connect</button>
    }
</div>


<img @ref="backgroundImage" id="bgImage" src="images/Sand_Background.png" alt="image" style="display:none;" />

<img @ref="wallImage" id="wallImage" src="images/WallSprite.png" alt="image" style="display:none;" />

<div id="snakeCanvas" style="position: fixed; width: 100%; height: 100%">
    <BECanvas Width="1000" Height="1000" @ref="canvasReference"></BECanvas>
</div>



@code
{
    /// <summary>
    /// Domain name of the server to be connected to.
    /// </summary>
    private string ServerDomainName = "localhost";

    /// <summary>
    /// Port on the server side to connect to.
    /// </summary>
    private int ServerPort = 11000;

    /// <summary>
    /// The player name to be used in the snake game.
    /// </summary>
    private string PlayerName = "John";

    /// <summary>
    /// Width of the display canvas
    /// </summary>
    private const int ViewWidth = 1000;

    /// <summary>
    /// Height of the display canvas
    /// </summary>
    private const int ViewHeight = 1000;

    /// <summary>
    /// Constant width of each wall
    /// </summary>
    private const int WallWidth = 50;

    /// <summary>
    ///   Total thickness of the snake to be drawn.
    /// </summary>
    private const int SnakeTotalThickness = 10;

    /// <summary>
    ///   The thickness of the snake stripe to be drawn.
    /// </summary>
    private const int SnakeStripeThickness = 6;

    /// <summary>
    ///   The color used to draw a dead snake.
    /// </summary>
    private const string SnakeDeadColor = $"rgb(0, 0, 0)";

    /// <summary>
    /// World object our player is in.
    /// </summary>
    private World world = new();

    private Queue<string> commandQueue = new(); // TODO REMOVE IF NECESSARY

    private bool commandSentThisFrame = false; // TODO REMOVE IF NEEDED.

    /// <summary>
    /// Controller object that receives information from the 
    /// server and updates the model. The GUI can send 
    /// requests to this controller to update the game state.
    /// </summary>
    private NetworkController controller = new(new()); // TODO COME UP WITH PERMANENT SOLUTION.

    private BECanvasComponent canvasReference = null!;
    private Canvas2DContext context = null!;
    private IJSObjectReference jsModule = null!;

    private ElementReference backgroundImage;
    private ElementReference wallImage;

    /// <summary>
    ///   Starts the client when this page is opened.
    /// </summary>
    /// <param name="firstRender"> Determines if this is the first render. </param>
    /// <returns> A task object for await purposes. </returns>
    protected override async Task OnAfterRenderAsync( bool firstRender )
    {
        if ( firstRender )
        {
            jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>( "import", "./Pages/SnakeGUI.razor.js" );
            context = await canvasReference.CreateCanvas2DAsync();
            await JsRuntime.InvokeAsync<object>( "initRenderJS", DotNetObjectReference.Create( this ) );
            controller = new(world);

            GameLoop();
        }
    }

    /// <summary>
    ///   TODO
    /// </summary>
    /// <param name="key"></param>
    [JSInvokable]
    public void HandleKeyPress( string key )
    {
        // commandQueue.Enqueue(key); TODO

        switch (key)
        {
            case "w": controller.CommandRequest(Direction.UP); break;
            case "s": controller.CommandRequest(Direction.DOWN); break;
            case "a": controller.CommandRequest(Direction.LEFT); break;
            case "d": controller.CommandRequest(Direction.RIGHT); break;
            default: controller.CommandRequest(Direction.NONE); break;
        }
    }

    /// <summary>
    /// Renders the view once every 20 milliseconds (50 frames/second)
    /// </summary>
    private async void GameLoop()
    {
        while (true)
        {
            Thread.Sleep(20);
            await DrawFrame();
        }

    }

    /// <summary>
    /// Draws the given wall.
    /// </summary>
    /// <param name="wall"> The wall to be draw. </param>
    /// <returns> Task used for await purposes. </returns>
    private async Task DrawWall(Wall wall){
        int start;
        int end;

        // Ensures the walls are drawn with the centers in the correct place.
        int wallOffset = WallWidth / 2;

        if (wall.P1.X == wall.P2.X) // Assume the wall are vertical
        {
            if(wall.P1.Y > wall.P2.Y)
            {
                start = wall.P2.Y;
                end = wall.P1.Y;

            }
            else{
                start = wall.P1.Y;
                end = wall.P2.Y;
            }
            for (int y = start; y <= end; y += WallWidth){
                await context.DrawImageAsync(wallImage, wall.P1.X - wallOffset, y - wallOffset, WallWidth, WallWidth);
            }
        }
        else // Assume the walls are horizontal
        {  
            if (wall.P1.X > wall.P2.X)
            {
                start = wall.P2.X;
                end = wall.P1.X;

            }
            else
            {
                start = wall.P1.X;
                end = wall.P2.X;
            }
            for (int x = start; x <= end; x += WallWidth)
            {
                await context.DrawImageAsync(wallImage, x - wallOffset, wall.P1.Y - wallOffset, WallWidth, WallWidth);
            }

        }
    }

    /// <summary>
    ///   Draws one segment of a snake at the given destination, color, and width
    ///   based on the given parameters in the shape of a capsule.
    /// </summary>
    /// <param name="point1">
    ///   First end (center point) of the snake segment to be drawn.
    /// </param>
    /// <param name="point2"> 
    ///   Second end (center point) of the snake segment to be drawn. 
    /// </param>
    /// <param name="color">
    ///   Gives a color in string rgb form that can be used to color this segment. 
    ///   Must be a valid HTML color either in word form or in rgb form. 
    ///   E.g: for rgb input "$rgb(100, 100, 100)"
    /// </param>
    /// <param name="width"> Width of the segment to be drawn. </param>
    /// <returns> A task object used for await purposes. </returns>
    private async Task DrawSnakeSegment(Point2D point1, Point2D point2, string color, int width)
    {
        // Point 1 circle:
        await context.SetLineWidthAsync(width/2);
        await context.SetStrokeStyleAsync(color);
        await context.BeginPathAsync();
        await context.ArcAsync(point1.X, point1.Y, width/4, 0, 2 * Math.PI);
        await context.StrokeAsync();

        // Point 2 circle:
        await context.BeginPathAsync();
        await context.ArcAsync(point2.X, point2.Y, width / 4, 0, 2 * Math.PI);
        await context.StrokeAsync();

        // Draw a line connecting point 1 and point 2:
        await context.SetLineWidthAsync(width);
        await context.BeginPathAsync();
        await context.MoveToAsync(point1.X, point1.Y);
        await context.LineToAsync(point2.X, point2.Y);
        await context.StrokeAsync();
    }

    /// <summary>
    ///   Draws a living snake object with a primary color and secondary color chosen 
    ///   by ColorChooser. The primary color is the remainder of the ID and 8 and 
    ///   the secondary color is the remainder of the ID - 1 and 8 according to 
    ///   how color chooser chooses colors.
    /// </summary>
    /// <param name="snake"> The snake to be drawn. </param>
    /// <returns> A task object used for await purposes. </returns>
    private async Task DrawLivingSnake(Snake snake)
    {
        Point2D previousSegment = snake.Body[0];

        for (int index = 1; index < snake.Body.Count; index++)
        {
            Point2D currentSegment = snake.Body[index];

            await DrawSnakeSegment(currentSegment, previousSegment, ColorChooser.ChooseColor(snake.ID), SnakeTotalThickness);

            previousSegment = currentSegment;
        }

        previousSegment = snake.Body[0];

        for (int index = 1; index < snake.Body.Count; index++)
        {
            Point2D currentSegment = snake.Body[index];

            await DrawSnakeSegment(currentSegment, previousSegment, ColorChooser.ChooseColor(snake.ID - 1), SnakeStripeThickness);

            previousSegment = currentSegment;
        }

        await context.SetFontAsync("bold 12pt monospace");
        await context.SetTextAlignAsync(TextAlign.Center);
        await context.SetFillStyleAsync("black");
        await context.FillTextAsync($"{snake.Name}:{snake.Score}", snake.Head.X, snake.Head.Y - 8);
    }

    /// <summary>
    ///   Draws a dead snake object with a single color defined by the SnakeDeadColor 
    ///   constant variable.
    /// </summary>
    /// <param name="snake"> The snake to be drawn. </param>
    /// <returns> A task object used for await purposes. </returns>
    private async Task DrawDeadSnake(Snake snake)
    {
        Point2D previousSegment = snake.Body[0];

        for (int index = 1; index < snake.Body.Count; index++)
        {
            Point2D currentSegment = snake.Body[index];

            await DrawSnakeSegment(currentSegment, previousSegment, SnakeDeadColor, SnakeTotalThickness);

            previousSegment = currentSegment;
        }
    }

    /// <summary>
    /// Method that defines how each powerup is drawn.
    /// </summary>
    /// <param name="powerup"> Powerup object being drawn </param>
    /// <returns> Task object used for await purposes </returns>
    private async Task DrawPowerup(Powerup powerup)
    {
        await context.SetLineWidthAsync(8);
        await context.SetStrokeStyleAsync($"rgb(255, 0, 0)");
        await context.BeginPathAsync();
        await context.ArcAsync(powerup.Location.X, powerup.Location.Y, 4, 0, 2 * Math.PI);
        await context.StrokeAsync();
    }


    /// <summary>
    ///   Draws the current state of the game in the game display canvas.
    /// </summary>
    /// <returns> Returns a Task object. TODO REMOVE? </returns>
    private async Task DrawFrame(){
        // Copy the world so that it can be drawn without being interrupted.
        World worldCopy;
        lock (world)
            worldCopy = new(world);



        // Batch is called here so that the early return doesn't prevent other operations from occuring.
        await context.BeginBatchAsync();

        if (!worldCopy.Snakes.ContainsKey(worldCopy.PlayerID))
        {
            if (controller.FailedToConnect)
            {
                await context.SetFontAsync("bold 30pt Times New Roman");
                await context.SetFillStyleAsync("red");
                await context.SetTextAlignAsync(TextAlign.Center);
                await context.FillTextAsync("FAILED TO CONNECT TO SERVER", ViewWidth / 2, ViewWidth / 2);
            }
            await context.EndBatchAsync();
            return;
        }

        // Draws the light blue canvas behind our game's background.
        await context.SetFillStyleAsync("lightblue");
        await context.FillRectAsync(0, 0, ViewWidth, ViewHeight);

        // clip the view so that objects drawn outside the canvas will not be shown
        await context.BeginPathAsync();

        await context.RectAsync(0, 0, ViewWidth, ViewHeight);
        await context.ClipAsync();

        // Because we are modifying the transformation matrix, we need to save it so we can restore it at the end
        await context.SaveAsync();

        // Center on origin, move to center of view port
        Snake player = worldCopy.Snakes[worldCopy.PlayerID];
        await context.TranslateAsync(ViewWidth / 2, ViewHeight / 2);
        await context.TranslateAsync(-player.Head.X, -player.Head.Y);

        // Draw the background:
        await context.DrawImageAsync(backgroundImage, -worldCopy.Size / 2, -worldCopy.Size / 2, worldCopy.Size, worldCopy.Size);

        // Draw walls.
        foreach(Wall wall in worldCopy.Walls.Values){
            await DrawWall(wall);
        }

        // Draw snakes.
        foreach (Snake snake in worldCopy.Snakes.Values)
        {
            if (snake.Alive)
                await DrawLivingSnake(snake);
            else
                await DrawDeadSnake(snake);
        }
        
        // Draw powerups.
        foreach (Powerup powerup in worldCopy.Powerups.Values) {
            await DrawPowerup(powerup); 
        }

        // Because we are modifying the transformation matrix, we need to restore it
        await context.RestoreAsync();

        await context.EndBatchAsync();

        StateHasChanged();
    }
}

